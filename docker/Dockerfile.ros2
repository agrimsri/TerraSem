# Multi-stage Dockerfile for TerraSem ROS 2 Humble Stack
FROM ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble

# Install system & ROS dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    python3-pip \
    python3-colcon-common-extensions \
    ros-humble-cv-bridge \
    ros-humble-sensor-msgs-py \
    ros-humble-message-filters \
    ros-humble-tf2-ros \
    ros-humble-nav-msgs \
    ros-humble-visualization-msgs \
    && rm -rf /var/lib/apt/lists/*

# Install ONNX Runtime & Python dependencies for CPU inference
RUN pip3 install --no-cache-dir \
    numpy \
    opencv-python-headless \
    onnxruntime \
    pillow \
    pyyaml

# Create ROS 2 workspace
WORKDIR /ros2_ws
COPY ros2_ws/src /ros2_ws/src
COPY checkpoints/segformer_b0_int8_dynamic.onnx /ros2_ws/checkpoints/segformer_b0_int8_dynamic.onnx

# Source base ROS and build overlay
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && colcon build --symlink-install"

# Set up entrypoint
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "terrasem_ros", "terrasem_bringup.launch.py"]
